APP_NAME="Restaurant"
APP_ENV=development
APP_SECRET_KEY="replace-with-a-long-random-secret"
DATABASE_URL="postgresql+psycopg://restaurant:replace-with-password@localhost:5432/restaurant"
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=replace-with-a-strong-database-password
WEB_PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# الكوكيز. في production لازم COOKIE_SECURE=true (التطبيق بيرفض يقلع لو
# غير كده). في development سيبها false عشان تشتغل على http://localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# الحماية من محاولات الدخول العنيفة على /admin/login
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_MAX_ATTEMPTS_PER_IP=20
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_ROWS_PER_KEY=50

# للوجات: LOG_LEVEL = DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT = text (للقراءة) | json (للتجميع)
LOG_LEVEL=INFO
LOG_FORMAT=text

# IPs المسموح لuvicorn إنها تثق في X-Forwarded-For منهم.
# سيبها 127.0.0.1 لو مفيش proxy، أو حط IP/شبكة الـproxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# داتابيز الاختبارات. لازم تنتهي بـ_test — الـconftest بيرفض يشتغل على
# أي داتابيز تانية. اتأكد إنها مش الـproduction.
TEST_DATABASE_URL="postgresql+psycopg://restaurant:replace-with-password@localhost:5432/restaurant_store_test"

# ============================================================
# Web Push / VAPID (Phase 3)
# ============================================================
# إشعارات الطلبات اختيارية تماماً. الموقع يشتغل من غيرها عادي.
#
# **المفتاح الخاص سري، وباقي في السيرفر بس.** ما ينفعش يتعمله endpoint
# ولا يتقرا من أي frontend. مفيش مفيش metadata كتير: مفيش مطور يقدر
# يعرف إن في مفتاح واحد.
#
# توليد زوج جديد (ما بتعملوش التوليد على السيرفر نفسه):
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; k=ec.generate_private_key(ec.SECP256R1()); d=k.private_bytes(serialization.Encoding.DER, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()); n=k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint); b=lambda x: base64.urlsafe_b64encode(x).rstrip(b'=').decode(); print('VAPID_PRIVATE_KEY='+b(d)); print('VAPID_PUBLIC_KEY='+b(n))"
#
# اتأكد `VAPID_SUBJECT` بيروح لمطعمك فعلياً — المزوّد بيبعته في كل
# طلب. لو فرّغته: الإشعارات بتتوقف (الزر بيختفي بـenabled: false).
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
PUSH_SEND_TIMEOUT_SECONDS=10
