APP_NAME="Restaurant"
APP_ENV=development
APP_SECRET_KEY="replace-with-a-long-random-secret"
DATABASE_URL="postgresql+psycopg://restaurant:replace-with-password@localhost:5432/restaurant"
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=replace-with-a-strong-database-password
WEB_PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# الكوكيز. في production لازم COOKIE_SECURE=true (التطبيق بيرفض يقلع لو
# غير كده). في development سيبها false عشان تشتغل على http://localhost.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# الحماية من محاولات الدخول العنيفة على /admin/login
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_MAX_ATTEMPTS_PER_IP=20
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_ROWS_PER_KEY=50

# للوجات: LOG_LEVEL = DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT = text (للقراءة) | json (للتجميع)
LOG_LEVEL=INFO
LOG_FORMAT=text

# IPs المسموح لuvicorn إنها تثق في X-Forwarded-For منهم.
# سيبها 127.0.0.1 لو مفيش proxy، أو حط IP/شبكة الـproxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# داتابيز الاختبارات. لازم تنتهي بـ_test — الـconftest بيرفض يشتغل على
# أي داتابيز تانية. اتأكد إنها مش الـproduction.
TEST_DATABASE_URL="postgresql+psycopg://restaurant:replace-with-password@localhost:5432/restaurant_store_test"
